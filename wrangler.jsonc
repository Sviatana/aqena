{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aqena",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "aqena.ai24solutions.online",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://aqena.ai24solutions.online",
    "NEXT_PUBLIC_SITE_URL": "https://aqena.ai24solutions.online",
    "BILLING_MODE": "mock",
    "ALLOW_MOCK_BILLING": "false"
  },
  "keep_vars": true,
  "secrets": {
    "required": [
      "SUPABASE_SECRET_KEY",
      "OPENROUTER_API_KEY"
    ]
  }
}
