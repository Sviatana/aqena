{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paralect-chatbot-builder",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "secrets": {
    "required": [
      "SUPABASE_SECRET_KEY",
      "OPENROUTER_API_KEY"
    ]
  }
}
